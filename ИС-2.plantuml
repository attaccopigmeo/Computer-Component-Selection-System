@startuml project
skinparam classAttributeIconSize 0

title <b>Диаграмма классов</b>\n<b>Система подбора компьютерных комплектующих</b>

skinparam backgroundColor #FAEBD7
skinparam defaultFontName monospace
skinparam DefaultFontSize 16
skinparam TitleFontSize 20
skinparam ClassFontColor #4169E1

class Пользователь {
    - id: int
    - имя: string
    - бюджет: decimal
    - назначениеПК: string
    - желаемоеРазрешение: string
    - требования: string
}

class КонфигурацияПК {
    - id: int
    - название: string
    - общаяСтоимость: decimal
    - энергопотребление: int
    - статусСовместимости: string
}

abstract class Комплектующее {
    - id: int
    - модель: string
    - производитель: string
    - цена: decimal
}

class Процессор {
    - socket: string
    - количествоЯдер: int
    - частота: float
    - TDP: int
}

class МатеринскаяПлата {
    - socket: string
    - chipset: string
    - типRAM: string
    - maxRAM: int
    - formFactor: string
    - интерфейсы: string
}

class ОперативнаяПамять {
    - типDDR: string
    - объем: int
    - частота: int
    - количествоМодулей: int
}

class Видеокарта {
    - объемVRAM: int
    - длина: int
    - TDP: int
    - рекомендуемаяМощностьБП: int
    - разъемыПитания: string
}

class Накопитель {
    - тип: string
    - интерфейс: string
    - объем: int
    - скоростьЧтения: int
}

class БлокПитания {
    - мощность: int
    - сертификат: string
    - разъемы: string
    - formFactor: string
}

class Корпус {
    - formFactor: string
    - maxДлинаGPU: int
    - maxВысотаКулера: int
}

class СистемаОхлаждения {
    - поддерживаемыеSocket: string
    - высота: int
    - maxTDP: int
    - тип: string
}
' Наследование
Комплектующее <|-- Процессор
Комплектующее <|-- МатеринскаяПлата
Комплектующее <|-- ОперативнаяПамять
Комплектующее <|-- Видеокарта
Комплектующее <|-- Накопитель
Комплектующее <|-- БлокПитания
Комплектующее <|-- Корпус
Комплектующее <|-- СистемаОхлаждения

' Аccоциации
Пользователь "1" -- "0..*" КонфигурацияПК: формирует >
КонфигурацияПК "1" *-- "1" Процессор
КонфигурацияПК "1" *-- "1" МатеринскаяПлата
КонфигурацияПК "1" *-- "1..4" ОперативнаяПамять
КонфигурацияПК "1" *-- "0..2" Видеокарта
КонфигурацияПК "1" *-- "1..4" Накопитель
КонфигурацияПК "1" *-- "1" БлокПитания
КонфигурацияПК "1" *-- "1" Корпус
КонфигурацияПК "1" *-- "1" СистемаОхлаждения

' Логические связи совместимости
Процессор "1" --> "0" МатеринскаяПлата : совместим по socket
МатеринскаяПлата "1" --> "0..*" ОперативнаяПамять : поддерживает
МатеринскаяПлата "1" --> "0..*" Накопитель : подключает
Видеокарта "1" --> "1" БлокПитания : требует
Корпус "1" --> "0..*" МатеринскаяПлата : вмещает
Корпус "1" --> "0..*" Видеокарта : вмещает
Корпус "1" --> "0..*" СистемаОхлаждения : вмещает
СистемаОхлаждения "1" --> "0..*" Процессор : охлаждает

' База продукционных правил
БазаПравил "1" *-- "12" ПродукционноеПравило : содержит
ПродукционноеПравило "1" --> "0..*" Рекомендация : формирует
БазаПравил ..> КонфигурацияПК : проверяе

' База продукционных правил
note right of ПродукционноеПравило
  IF: условиеIF
  THEN: заключениеTHEN
  CF: факторУверенности (0..1)
end note

' R01 — Совместимость сокета CPU
object "R01: Сокет CPU" as R01 {
  id = "R01"
  название = "Совместимость сокета"
  условиеIF = "CPU.socket != MB.socket"
  заключениеTHEN = "Компоненты несовместимы"
  факторУверенности = 0.99
}

' R02 — Тип оперативной памяти
object "R02: Тип RAM" as R02 {
  id = "R02"
  название = "Проверка типа RAM"
  условиеIF = "RAM.типDDR != MB.типRAM"
  заключениеTHEN = "Память несовместима"
  факторУверенности = 0.99
}

' R03 — Максимальный объем RAM
object "R03: Объем RAM" as R03 {
  id = "R03"
  название = "Проверка объема RAM"
  условиеIF = "RAM.общийОбъем > MB.maxRAM"
  заключениеTHEN = "Объем не поддерживается"
  факторУверенности = 0.98
}

' R04 — Мощность блока питания
object "R04: Мощность БП" as R04 {
  id = "R04"
  название = "Проверка мощности БП"
  условиеIF = "БП.мощность < ПК.энергопотребление * 1.25"
  заключениеTHEN = "Недостаточная мощность"
  факторУверенности = 0.95
}

' R05 — Требования видеокарты к питанию
object "R05: Питание GPU" as R05 {
  id = "R05"
  название = "Требования GPU к БП"
  условиеIF = "БП.мощность < GPU.рекомендуемаяМощностьБП"
  заключениеTHEN = "БП не соответствует требованиям GPU"
  факторУверенности = 0.98
}

' R06 — Разъемы питания видеокарты
object "R06: Разъемы GPU" as R06 {
  id = "R06"
  название = "Проверка разъемов питания"
  условиеIF = "Разъемы GPU не обеспечены БП"
  заключениеTHEN = "Нет подходящего подключения питания"
  факторУверенности = 0.97
}

' R07 — Форм-фактор материнской платы
object "R07: Форм-фактор" as R07 {
  id = "R07"
  название = "Проверка форм-фактора"
  условиеIF = "MB.formFactor не поддерживается корпусом"
  заключениеTHEN = "Плата не подходит к корпусу"
  факторУверенности = 0.99
}

' R08 — Длина видеокарты
object "R08: Длина GPU" as R08 {
  id = "R08"
  название = "Проверка длины видеокарты"
  условиеIF = "GPU.длина > Корпус.maxДлинаGPU"
  заключениеTHEN = "Видеокарта не помещается"
  факторУверенности = 0.99
}

' R09 — Совместимость кулера и процессора
object "R09: Сокет кулера" as R09 {
  id = "R09"
  название = "Проверка крепления кулера"
  условиеIF = "CPU.socket не поддерживается кулером"
  заключениеTHEN = "Кулер несовместим с CPU"
  факторУверенности = 0.99
}

' R10 — Высота кулера
object "R10: Высота кулера" as R10 {
  id = "R10"
  название = "Проверка высоты кулера"
  условиеIF = "Кулер.высота > Корпус.maxВысотаКулера"
  заключениеTHEN = "Кулер не помещается"
  факторУверенности = 0.99
}

' R11 — Интерфейс накопителя
object "R11: Интерфейс диска" as R11 {
  id = "R11"
  название = "Проверка интерфейса накопителя"
  условиеIF = "Интерфейс диска не поддерживается платой"
  заключениеTHEN = "Накопитель нельзя подключить"
  факторУверенности = 0.97
}

' R12 — Проверка бюджета
object "R12: Бюджет" as R12 {
  id = "R12"
  название = "Проверка бюджета"
  условиеIF = "ПК.общаяСтоимость > Пользователь.бюджет
  заключениеTHEN = "Превышен бюджет"
  факторУверенности = 1.00
}

' Связи базы с правилами
БазаПравил .. R01
БазаПравил .. R02
БазаПравил .. R03
БазаПравил .. R04
БазаПравил .. R05
БазаПравил .. R06
БазаПравил .. R07
БазаПравил .. R08
БазаПравил .. R09
БазаПравил .. R10
БазаПравил .. R11
БазаПравил .. R12

@enduml